#include <math.h>
#include <mpi.h>
#include <petscvec.h>
#include <stdio.h>
#undef VecMaxPointwiseDivide
PetscErrorCode VecMaxPointwiseDivide(Vec x, Vec y, PetscReal *max);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);

int main(void) {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);
  // Vectors x and y
  $vec x = $vec_zero(0);
  $vec y = $vec_zero(0);
  if (rank == 0) {
    // Populate input values
    STYPE x_values[N], y_values[N];
    for (int i = 0; i < N; i++) {
#ifdef USE_COMPLEX
      x_values[i] = $make_complex((double)(i + 1), 0.0);
      y_values[i] = $make_complex((double)(i + 2), 0.0);
#else
      x_values[i] = (double)(i + 1);
      y_values[i] = (double)(i + 2);
#endif
    }
    // Create vectors from input values
    x = $vec_make_from_dense(N, x_values);
    y = $vec_make_from_dense(N, y_values);
    $print("N = ", N, "\n");
    $print("Vector x: ");
    $vec_print(x);
    $print("\nVector y: ");
    $vec_print(y);
  }
  PetscReal max_actual, max_expected;
  Vec p_x = civlToPetscVec(x, PETSC_DECIDE, comm);
  Vec p_y = civlToPetscVec(y, PETSC_DECIDE, comm);
  PetscErrorCode err_actual = VecMaxPointwiseDivide(p_x, p_y, &max_actual);
  PetscErrorCode err_expected = VecMaxPointwiseDivide_spec(p_x, p_y, &max_expected);
  $assert(err_actual == err_expected);
  if (rank == 0) {
    //$pathCondition();
    $print("\nMax actual   = ", max_actual, "\n");
    $print("Max expected = ", max_expected, "\n\n");
    $assert(max_actual == max_expected);
  }
  // Clean up
  VecDestroy(&p_x);
  VecDestroy(&p_y);
  MPI_Finalize();
}

