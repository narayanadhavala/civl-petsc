#include <math.h>
#include <mpi.h>
#include <petscvec.h>
#include <stdio.h>
#undef VecMaxPointwiseDivide
PetscErrorCode VecMaxPointwiseDivide(Vec x, Vec y, PetscReal *max);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);

$input CIVL_RTYPE X_Real[N], Y_Real[N];
#ifdef USE_COMPLEX
$input CIVL_RTYPE X_Imag[N], Y_Imag[N];
#endif

int main(void) {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);
  // Vectors x and y
  $vec x = $vec_zero(0);
  $vec y = $vec_zero(0);
  if (rank == 0) {
    // Populate input values
    STYPE x_values[N], y_values[N];
    for (int i = 0; i < N; i++) {
      x_values[i] = scalar_make(X_Real[i], X_Imag[i]);
      y_values[i] = $make_complex(Y_Real[i], Y_Imag[i]);
    }
    // Create vectors from input values
    x = $vec_make_from_dense(N, x_values);
    y = $vec_make_from_dense(N, y_values);
    $print("\nN = ", N, "\nx: ");
    $vec_print(x);
    $print("\ny: ");
    $vec_print(y);
  }

  CIVL_RTYPE max_actual, max_expected;
  Vec p_x = civlToPetscVec(x, PETSC_DECIDE, comm);
  Vec p_y = civlToPetscVec(y, PETSC_DECIDE, comm);
  PetscErrorCode err_actual = VecMaxPointwiseDivide(p_x, p_y, &max_actual);
  VecMaxPointwiseDivide_spec(p_x, p_y, &max_expected);
  $assert(err_actual == 0);
  if (rank == 0) {
    $print("\n");
    $pathCondition();
    $print("\nMax actual   = ", max_actual, "\n\nMax expected = ", max_expected, "\n");
    $assert(max_actual == max_expected);
  }
  // Clean up
  VecDestroy(&p_x);
  VecDestroy(&p_y);
  MPI_Finalize();
}

