#include "petscvec.h"
#include <mpi.h>
#include <stdio.h>
#undef VecMax
PetscErrorCode VecMax(Vec x, PetscInt *p, PetscReal *val);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);

$input CIVL_RTYPE X_Real[N];
#ifdef USE_COMPLEX
$input CIVL_RTYPE X_Imag[N];
#endif

int main() {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank, p_actual, p_expected;
  MPI_Comm_rank(comm, &rank);
  $vec x = $vec_zero(0);

  STYPE x_values[N];
  CIVL_RTYPE actual, expected;

  if (rank == 0) {
    for (int i = 0; i < N; i++)
      x_values[i] = scalar_make(X_Real[i], X_Imag[i]);

    x = $vec_make_from_dense(N, x_values);

    $print("Vector x:\n");
    $vec_print(x);
  }

  Vec p_x = civlToPetscVec(x, PETSC_DECIDE, comm);
  PetscErrorCode err_actual = VecMax(p_x, &p_actual, &actual);
  VecMax_spec(p_x, &p_expected, &expected);

  if (rank == 0) {
    $print("\n");
    $pathCondition();
    $print("\nActual Vec Max   = ", actual, " at index ", p_actual, "\n\n",
           "Expected Vec Max = ", expected, " at index ", p_expected, "\n\n");
  }
  $assert(err_actual == 0);
  $assert(p_actual == p_expected);
  $assert(actual == expected);

  VecDestroy(&p_x);
  MPI_Finalize();
}
