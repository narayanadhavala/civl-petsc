#include "petscvec.h"
#include <mpi.h>
#include <stdio.h>
#undef VecSetValues

PetscErrorCode VecSetValues(Vec x, PetscInt ni, const PetscInt ix[],
                            const PetscScalar y[], InsertMode iora);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);

$input int ni, B, ix[ni]; // Number of indices to set
#assume(0 <= B && B <= N);
$assume(0 <= ni && ni <= B); // Assume ni is valid and within bounds
$assume($forall (int j : 0..ni - 1)(0 <= ix[j] && ix[j] < N));
$assume($forall (int j : 0..ni - 1) $forall (int k: 0..j - 1) ix[j] != ix[k]);

#ifdef USE_COMPLEX
    $input CIVL_RTYPE Y_Real[ni], Y_Imag[ni], X_Real[N], X_Imag[N];
#else
    $input CIVL_RTYPE Y_Real[ni],
    X_Real[N];
#endif

int main() {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);

  $vec x = $vec_zero(N);
  STYPE y_values[ni];

  if (rank == 0) {
    STYPE x_values[N];

    for (int i = 0; i < N; i++)
      x_values[i] = $cmake(X_Real[i], X_Imag[i]);

    for (int i = 0; i < ni; i++)
      y_values[i] = $cmake(Y_Real[i], Y_Imag[i]);

    x = $vec_make_from_dense(N, x_values);

    $print("Initial Vector x:\n");
    $vec_print(x);
    $print("\nValues to insert (y):\n");
    for (int i = 0; i < ni; i++)
      $cprint(y_values[i]);
    $print("\nIndices (ix):\n");
    for (int i = 0; i < ni; i++)
      $print("ix[", i, "] = ", ix[i], "\n");
  }

  Vec p_x = civlToPetscVec(x, PETSC_DECIDE, comm);
  Vec expected = civlToPetscVec(x, PETSC_DECIDE, comm);

  PetscErrorCode err_actual =
      VecSetValues(p_x, ni, ix, y_values, INSERT_VALUES);
  PetscErrorCode err_expected =
      VecSetValues_spec(expected, ni, ix, y_values, INSERT_VALUES);

  $assert(err_actual == err_expected, "Error codes do not match.");
  PetscBool flg;
  VecEqual(p_x, expected, &flg);
  $assert(flg, "Vector Value mismatch after VecSetValues.");

  if (rank == 0) {
    $print("\n");
    $pathCondition();
  }
  vecprint_mpi("\nActual   VecSetValues", p_x);
  vecprint_mpi("\nExpected VecSetValues", expected);
  $print("\n");

  VecDestroy(&p_x);
  VecDestroy(&expected);

  MPI_Finalize();
}
