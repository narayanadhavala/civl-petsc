#include "petscvec.h"
#include <mpi.h>
#include <stdio.h>
#undef VecDot
PetscErrorCode VecDotRealPart(Vec x, Vec y, PetscReal *val);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);

#ifdef USE_COMPLEX
$input CIVL_RTYPE X_Real[N], X_Imag[N], Y_Real[N], Y_Imag[N];
#else
$input CIVL_RTYPE X_Real[N], Y_Real[N];
#endif

int main(void) {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);
  $vec x = $vec_zero(0);
  $vec y = $vec_zero(0);

  STYPE x_values[N], y_values[N];
  CIVL_RTYPE actual, expected;

  if (rank == 0) {
    for (int i = 0; i < N; i++) {
#ifdef USE_COMPLEX
      x_values[i] = $make_complex(X_Real[i], X_Imag[i]);
      y_values[i] = $make_complex(Y_Real[i], Y_Imag[i]);
#else
      x_values[i] = X_Real[i];
      y_values[i] = Y_Real[i];
#endif
    }

    x = $vec_make_from_dense(N, x_values);
    y = $vec_make_from_dense(N, y_values);

    $print("Vector x:\n");
    $vec_print(x);
    $print("\nVector y:\n");
    $vec_print(y);
  }

  Vec p_x = civlToPetscVec(x, PETSC_DECIDE, comm);
  Vec p_y = civlToPetscVec(y, PETSC_DECIDE, comm);
  PetscErrorCode err_actual = VecDotRealPart(p_x, p_y, &actual);
  PetscErrorCode err_expected = VecDotRealPart_spec(p_x, p_y, &expected);

  $assert(err_actual == err_expected);
  $assert(actual == expected);

  if (rank == 0)
    $print("\nVecDotRealPart = ", actual, "\n\n");
  
  VecDestroy(&p_x);
  VecDestroy(&p_y);
  MPI_Finalize();
  return 0;
}
