#include "petscvec.h"
#include <mpi.h>
#include <stdio.h>
#undef VecSet
PetscErrorCode VecSet(Vec x, PetscScalar alpha);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);

#ifdef USE_COMPLEX
$input CIVL_RTYPE alpha_Real, alpha_Imag;
#else
$input CIVL_RTYPE alpha_Real;
#endif

int main() {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);
  $vec x = $vec_zero(N), y = $vec_zero(N);

  STYPE alpha = $cmake(alpha_Real, alpha_Imag);

  if (rank == 0) {
    $print("Vector x:\n");
    $vec_print(x);
  }

  Vec actual = civlToPetscVec(x, PETSC_DECIDE, comm);
  Vec expected = civlToPetscVec(y, PETSC_DECIDE, comm);
  PetscErrorCode err_actual = VecSet(actual, alpha);
  PetscErrorCode err_expected = VecSet_spec(expected, alpha);

  $assert(err_actual == err_expected);
  bool flg;
  VecEqual(actual, expected, &flg);
  $assert(flg == $true, "Vector Value mismatch.");

  if (rank == 0) {
    $print("\n");
    $pathCondition();
  }
  vecprint_mpi("\nActual   VecSet", actual);
  vecprint_mpi("\nExpected VecSet", expected);

  VecDestroy(&actual);
  VecDestroy(&expected);
  MPI_Finalize();
  return 0;
}
