#include "petscvec.h"
#undef VecSet
PetscErrorCode VecSet(Vec x, PetscScalar alpha);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);
$input CIVL_RTYPE alpha_Real;
#ifdef USE_COMPLEX
$input CIVL_RTYPE alpha_Imag;
#endif

int main() {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank, size;
  MPI_Comm_size(comm, &size);
  MPI_Comm_rank(comm, &rank);
  $vec x = $vec_zero(N), y = $vec_zero(N);
  STYPE alpha = scalar_make(alpha_Real, alpha_Imag);
  if (rank == 0) {
    $print("\nVecSet_driver: nproc = ", size,", N = ", N, ", alpha = ", alpha, " ...");
#ifdef DEBUG
    $print("\nx: ");
    $vec_print(x);
#endif
  }
  Vec actual = civlToPetscVec(x, PETSC_DECIDE, comm);
  Vec expected = civlToPetscVec(y, PETSC_DECIDE, comm);
  VecSet_spec(expected, alpha);
  PetscErrorCode err_actual = VecSet(actual, alpha);
  $assert(err_actual == 0);
#ifdef DEBUG
  vecprint_mpi("Actual  ", actual);
  vecprint_mpi("Expected", expected);
#endif
  bool flg;
  VecEqual(actual, expected, &flg);
  $assert(flg, "VecSet mismatch  for actual and expected values.");
#ifndef DEBUG
  if (rank == 0)
    $print(" ok ");
#endif
  VecDestroy(&actual);
  VecDestroy(&expected);
  MPI_Finalize();
}
