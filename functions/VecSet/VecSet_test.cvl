#include "petscvec.h"
#include <mpi.h>
#include <stdio.h>

$input int n = 5, value = 5;

int main() {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);
  $vec x = $vec_zero(n), y = $vec_zero(n);

  STYPE alpha;

#ifdef USE_COMPLEX
  alpha = $make_complex(value, 0.0);
#else
  alpha = value;
#endif

  if (rank == 0) {
    for (int i = 0; i < n; i++)
      y = $vec_set(y, i, alpha);

    $print("Vector x:\n");
    $vec_print(x);
    $print("\nVector y:\n");
    $vec_print(y);
  }

  Vec actual = CIVL_CivlToPetscVec(x, PETSC_DECIDE, comm);
  Vec expected = CIVL_CivlToPetscVec(y, PETSC_DECIDE, comm);
  PetscErrorCode err_actual = VecSet(actual, alpha);

  $assert(err_actual == $false);
  bool flg;
  VecEqual(actual, expected, &flg);
  $assert(flg == $true, "Vector Value mismatch.");

  if (rank == 0) {
    $print("\n");
    $pathCondition();
  }
  CIVL_PrintVec("\nActual   VecSet", actual);
  CIVL_PrintVec("\nExpected VecSet", expected);

  VecDestroy(&actual);
  VecDestroy(&expected);
  MPI_Finalize();
  return 0;
}
