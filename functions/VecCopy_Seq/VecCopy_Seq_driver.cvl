#include <petscvec.h>
#include <stdio.h>
#undef VecCopy_Seq
PetscErrorCode VecCopy_Seq(Vec xin, Vec yin);

int main(int argc, char** argv) {
    STYPE value[N];
    create_vector_values(N, value);
    MPI_Init(NULL, NULL);
    MPI_Comm comm = MPI_COMM_WORLD;
    $vec x = $vec_make_from_dense(N, value);
    $vec y = $vec_zero(N);
    int rank;
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    Vec p_x = civlToPetscVec(x, PETSC_DECIDE, comm), p_y = civlToPetscVec(y, PETSC_DECIDE, comm);
    VecCopy_Seq(p_x, p_y);
    $vec c_x = petscToCivlVec(p_x), c_y = petscToCivlVec(p_y);
    if (rank == 0) {
        printf("For N: %d\n", N);
        printf("Before VecCopy_Seq:\n");
        printf("x = ");
        $vec_print(x);
        printf("y = ");
        $vec_print(y);
        printf("After VecCopy_Seq:\n");
        printf("x = ");
        $vec_print(c_x);
        printf("y = ");
        $vec_print(c_y);
        printf("\n");
    }
    $assert($vec_eq(c_x, c_y));
    vec_destroy_seq(p_x);
    vec_destroy_seq(p_y);
    MPI_Finalize();
    return 0;
}
