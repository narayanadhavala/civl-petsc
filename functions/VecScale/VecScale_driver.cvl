#include "petscvec.h"
#include <mpi.h>
#include <stdio.h>
#undef VecScale
PetscErrorCode VecScale(Vec x, PetscScalar alpha);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);

#ifdef USE_COMPLEX
$input CIVL_RTYPE X_Real[N], X_Imag[N], alpha_Real, alpha_Imag;
#else
$input CIVL_RTYPE X_Real[N], alpha_Real;
#endif

int main() {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);
  $vec x = $vec_zero(N);

  STYPE x_values[N], alpha = $cmake(alpha_Real, alpha_Imag);

  if (rank == 0) {
    for (int i = 0; i < N; i++)
      x_values[i] = $cmake(X_Real[i], X_Imag[i]);

    x = $vec_make_from_dense(N, x_values);

    $print("Vector x:\n");
    $vec_print(x);
  }

  Vec p_x = civlToPetscVec(x, PETSC_DECIDE, comm);
  Vec p_expected = civlToPetscVec(x, PETSC_DECIDE, comm);
  PetscErrorCode err_actual = VecScale(p_x, alpha);
  PetscErrorCode err_expected = VecScale_spec(p_expected, alpha);

  $assert(err_actual == err_expected);
  bool flg;
  VecEqual(p_x, p_expected, &flg);
  $assert($true == flg, "Scale Mismatch");

  if (rank == 0) {
    $print("\n");
    $pathCondition();
  }
  vecprint_mpi("\nActual   Vec Scale", p_x);
  vecprint_mpi("\nExpected Vec Scale", p_expected);

  VecDestroy(&p_x);
  VecDestroy(&p_expected);
  MPI_Finalize();
}
