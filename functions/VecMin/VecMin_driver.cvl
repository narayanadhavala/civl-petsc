#include "petscvec.h"
#include <mpi.h>
#include <stdio.h>
#undef VecMin
PetscErrorCode VecMin(Vec x, PetscInt *p, PetscReal *val);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);

#ifdef USE_COMPLEX
$input CIVL_RTYPE X_Real[N], X_Imag[N];
#else
$input CIVL_RTYPE X_Real[N];
#endif

int main() {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank, p_actual, p_expected;
  MPI_Comm_rank(comm, &rank);
  $vec x = $vec_zero(0);

  STYPE x_values[N];
  CIVL_RTYPE actual, expected;

  if (rank == 0) {
    for (int i = 0; i < N; i++) {
#ifdef USE_COMPLEX
      x_values[i] = $make_complex(X_Real[i], X_Imag[i]);
#else
      x_values[i] = X_Real[i];
#endif
    }

    x = $vec_make_from_dense(N, x_values);

    $print("Vector x:\n");
    $vec_print(x);
  }

  Vec p_x = civlToPetscVec(x, PETSC_DECIDE, comm);
  PetscErrorCode err_actual = VecMin(p_x, &p_actual, &actual);
  PetscErrorCode err_expected = VecMin_spec(p_x, &p_expected, &expected);

  $assert(err_actual == err_expected);
  $assert(p_actual == p_expected);
  $assert(actual == expected);

  if (rank == 0)
    $pathCondition();
  $print("\nActual Vec Max   = ", actual, " at index ", p_actual, "\n",
         "Expected Vec Max = ", expected, " at index ", p_expected, "\n\n");

  VecDestroy(&p_x);
  MPI_Finalize();
  return 0;
}
