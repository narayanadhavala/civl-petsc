#include "petscvec.h"
#include <mpi.h>
#include <stdio.h>
#undef VecMin
PetscErrorCode VecMin(Vec x, PetscInt *p, PetscReal *val);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);

$input CIVL_RTYPE X_Real[N];
#ifdef USE_COMPLEX
$input CIVL_RTYPE X_Imag[N];
#else
#endif

int main() {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank, p_actual, p_expected;
  MPI_Comm_rank(comm, &rank);
  $vec x = $vec_zero(0);

  STYPE x_values[N];
  CIVL_RTYPE actual, expected;

  if (rank == 0) {
    for (int i = 0; i < N; i++)
      x_values[i] = scalar_make(X_Real[i], X_Imag[i]);

    x = $vec_make_from_dense(N, x_values);

    $print("\nN = ", N, "\nx: ");
    $vec_print(x);
  }

  Vec p_x = civlToPetscVec(x, PETSC_DECIDE, comm);
  PetscErrorCode err_actual = VecMin(p_x, &p_actual, &actual);
  VecMin_spec(p_x, &p_expected, &expected);

  $assert(err_actual == 0);
  $assert(p_actual == p_expected);
  $assert(actual == expected);

  if (rank == 0){
    $print("\n");
    $pathCondition();
    $print("\nActual Vec Min = ", actual, " at index ", p_actual, "\n",
         "Expected Vec Min = ", expected, " at index ", p_expected, "\n");
  }

  VecDestroy(&p_x);
  MPI_Finalize();
  return 0;
}
