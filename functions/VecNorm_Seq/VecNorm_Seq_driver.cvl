#include <math.h>
#include <mpi.h>
#include <petscvec.h>
#include <stdio.h>
#undef VecNorm_Seq
PetscErrorCode VecNorm_Seq(Vec xin, NormType type, PetscReal *z);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);

#ifdef USE_COMPLEX
$input CIVL_RTYPE X_Real[N], X_Imag[N];
#else
$input CIVL_RTYPE X_Real[N];
#endif

int main(void) {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);
  $vec x = $vec_zero(N);
  STYPE x_values[N];

  if (rank == 0) {
    for (int i = 0; i < N; i++)
      x_values[i] = $cmake(X_Real[i], X_Imag[i]);
    x = $vec_make_from_dense(N, x_values);
    $print("CIVL Vector:");
    $vec_print(x);
  }

  Vec p_x = civlToPetscVec(x, PETSC_DECIDE, comm);
  CIVL_RTYPE expected[2] = {0.0, 0.0}, actual[2];
  int normType = $choose_int(5);
  printf("N = %d", N);
  printf("\n");
  if (rank == 0) {
    switch (normType) {
    case NORM_1:
      printf("NORM_1:\n");
      break;
    case NORM_2:
      printf("NORM_2:\n");
      break;
    case NORM_FROBENIUS:
      printf("NORM_FROBENIUS:\n");
      break;
    case NORM_INFINITY:
      printf("NORM_INFINITY:\n");
      break;
    case NORM_1_AND_2:
      printf("NORM_1_AND_2:\n");
      break;
    default:
      printf("Unknown:\n");
    }
  }
  PetscErrorCode err_expected = VecNorm_Seq_spec(p_x, normType, expected);
  if (normType == NORM_1_AND_2)
    printf("expected = %lf, %lf\n", expected[0], expected[1]);
  else
    printf("expected = %lf\n", expected[0]);
  PetscErrorCode err_actual = VecNorm_Seq(p_x, normType, actual);
  if (normType == NORM_1_AND_2) {
    printf("actual   = %lf, %lf\n\n", actual[0], actual[1]);
    $assert(expected[0] == actual[0]);
    $assert(expected[1] == actual[1]);
  } else {
    printf("actual   = %lf\n\n", actual[0]);
    $assert(expected[0] == actual[0]);
  }
  $assert(err_expected == err_actual);
  vec_destroy_seq(p_x);
  MPI_Finalize();
}
