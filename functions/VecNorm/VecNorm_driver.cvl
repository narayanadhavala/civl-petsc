#include <math.h>
#include <mpi.h>
#include <petscvec.h>
#include <stdio.h>
#undef VecNorm
PetscErrorCode VecNorm(Vec xin, NormType type, PetscReal *z);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);

#ifdef USE_COMPLEX
$input CIVL_RTYPE A_Real[N], A_Imag[N];
#else
$input CIVL_RTYPE A_Real[N];
#endif

void printNormType(NormType type) {
  switch (type) {
  case NORM_1:
    printf("NORM_1: ");
    break;
  case NORM_2:
    printf("NORM_2: ");
    break;
  case NORM_FROBENIUS:
    printf("NORM_FROBENIUS: ");
    break;
  case NORM_INFINITY:
    printf("NORM_INFINITY: ");
    break;
  case NORM_1_AND_2:
    printf("NORM_1_AND_2: ");
    break;
  default:
    printf("Unknown: ");
  }
}

int main(void) {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);
  $vec x = $vec_zero(0);
  int normType;
  if (rank == 0) {
    STYPE value[N];
    for (int i = 0; i < N; i++)
      value[i] = $cmake(A_Real[i], A_Imag[i]);

    x = $vec_make_from_dense(N, value);
    $print("CIVL:");
    $vec_print(x);
    normType = $choose_int(5);
  }

  MPI_Bcast(&normType, 1, MPI_INT, 0, comm);
  Vec p_x = civlToPetscVec(x, PETSC_DECIDE, comm);
  CIVL_RTYPE expected[2] = {0.0, 0.0}, actual[2];

  PetscErrorCode err_actual = VecNorm(p_x, normType, actual);
  PetscErrorCode err_expected = VecNorm_spec(p_x, normType, expected);

  $assert(err_actual == err_expected);
  if (rank == 0) {
    $print("\nN = ", N, "\n");
    $pathCondition();

    // Assert and print actual & expected calculated norm values
    if (normType == NORM_1_AND_2) {
      $assert(actual[0] == expected[0]);
      $assert(actual[1] == expected[1]);
      printNormType(normType);
      $print("Actual   = ", actual, "\n");
      printNormType(normType);
      $print("Expected = ", expected, "\n");
    } else {
      $assert(actual[0] == expected[0]);
      printNormType(normType);
      $print("Actual   = ", actual[0], "\n");
      printNormType(normType);
      $print("Expected = ", expected[0], "\n");
    }
  }
  VecDestroy(&p_x);
  MPI_Finalize();
}
