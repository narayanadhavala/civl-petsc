#include "petscvec.h"
#include <mpi.h>
#include <pointer.cvh>
#undef VecDot
PetscErrorCode VecDot(Vec x, Vec y, PetscScalar *val);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);

$input CIVL_RTYPE X_Real[N], Y_Real[N];
#ifdef USE_COMPLEX
$input CIVL_RTYPE X_Imag[N], Y_Imag[N];
#endif

int main(void) {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);
  // Vectors x and y
  $vec x = $vec_zero(0), y = $vec_zero(0);

  STYPE x_values[N], y_values[N], actual, expected;
  if (rank == 0) {
    for (int i = 0; i < N; i++) {
      x_values[i] = scalar_make(X_Real[i], X_Imag[i]);
      y_values[i] = scalar_make(Y_Real[i], Y_Imag[i]);
    }
    x = $vec_make_from_dense(N, x_values);
    y = $vec_make_from_dense(N, y_values);
    $print("\nN = ", N,"\nx: ");
    $vec_print(x);
    $print("\ny: ");
    $vec_print(y);
  }

  Vec p_x = civlToPetscVec(x, PETSC_DECIDE, comm);
  Vec p_y = civlToPetscVec(y, PETSC_DECIDE, comm);
  PetscErrorCode err_actual = VecDot(p_x, p_y, &actual);
  VecDot_spec(p_x, p_y, &expected);

  $assert(err_actual == 0);
  if (rank == 0) {
    $print("\n");
    $pathCondition();
    $print("\nActual  ", actual, "\n\nExpected", expected, "\n");
  }
  $assert($equals(&actual, &expected), "VecDot mismatch between actual and expected results.");

  VecDestroy(&p_x);
  VecDestroy(&p_y);
  MPI_Finalize();
}
