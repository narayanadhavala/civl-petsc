#include "petscvec.h"
#include <mpi.h>
#include <stdio.h>
#undef VecMAXPY

PetscErrorCode VecMAXPY(Vec y, PetscInt nv, const PetscScalar alpha[], Vec x[]);

$input int N_MIN, N_MAX, N, NV;
$assume(N_MIN <= N && N <= N_MAX);
$assume(1 <= NV && NV <= N);

#ifdef USE_COMPLEX
$input CIVL_RTYPE X_Real[NV][N], X_Imag[NV][N], Y_Real[N], Y_Imag[N],
    alpha_Real[NV], alpha_Imag[NV];
#else
$input CIVL_RTYPE X_Real[NV][N], Y_Real[N], alpha_Real[NV];
#endif

int main(void) {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);

  $vec x[NV];
  $vec y = $vec_zero(N);
  $vec z = $vec_zero(N);

  STYPE x_values[NV][N], y_values[N], alpha[NV];

  // Initialize alpha array
  for (int v = 0; v < NV; v++) {
#ifdef USE_COMPLEX
    alpha[v] = $make_complex(alpha_Real[v], alpha_Imag[v]);
#else
    alpha[v] = alpha_Real[v];
#endif
  }

  if (rank == 0) {
    for (int i = 0; i < N; i++) {
#ifdef USE_COMPLEX
      y_values[i] = $make_complex(Y_Real[i], Y_Imag[i]);
#else
      y_values[i] = Y_Real[i];
#endif
    }

    for (int v = 0; v < NV; v++) {
      for (int i = 0; i < N; i++) {
#ifdef USE_COMPLEX
        x_values[v][i] = $make_complex(X_Real[v][i], X_Imag[v][i]);
#else
        x_values[v][i] = X_Real[v][i];
#endif
      }
    }

    y = $vec_make_from_dense(N, y_values);
    z = $vec_make_from_dense(N, y_values);

    for (int v = 0; v < NV; v++)
      x[v] = $vec_make_from_dense(N, x_values[v]);

    $print("Vector y:\n");
    $vec_print(y);
    $print("Vector z:\n");
    $vec_print(z);
    for (int v = 0; v < NV; v++) {
      $print("Vector x[", v, "]:\n");
      $vec_print(x[v]);
    }
  }

  Vec p_x[NV];
  Vec p_y = civlToPetscVec(y, PETSC_DECIDE, comm);
  Vec expectedMAXPY = civlToPetscVec(z, PETSC_DECIDE, comm);

  for (int v = 0; v < NV; v++)
    p_x[v] = civlToPetscVec(x[v], PETSC_DECIDE, comm);

  MPI_Barrier(comm);
  PetscErrorCode err_actual = VecMAXPY(p_y, NV, alpha, p_x);
  PetscErrorCode err_expected = VecMAXPY_spec(expectedMAXPY, NV, alpha, p_x);

  MPI_Barrier(comm);
  $assert(err_actual == err_expected);
  bool flg;
  VecEqual(p_y, expectedMAXPY, &flg);

  if (rank == 0) {
    $print("\n");
    $pathCondition();
  }
  
  $assert(flg, "VecMAXPY mismatch between actual and expected results.");
  if (flg) {
    vecprint_mpi("\nActual MAXPY", p_y);
    vecprint_mpi("\nExpected MAXPY", expectedMAXPY);
  }

  VecDestroy(&p_y);
  VecDestroy(&expectedMAXPY);
  for (int v = 0; v < NV; v++)
    VecDestroy(&p_x[v]);

  MPI_Finalize();
}
