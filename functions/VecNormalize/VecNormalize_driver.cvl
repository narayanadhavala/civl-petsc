#include <mpi.h>
#include <petscvec.h>
#include <stdio.h>
#undef VecNormalize
PetscErrorCode VecNormalize(Vec x, PetscReal *val);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);

#ifdef USE_COMPLEX
$input CIVL_RTYPE A_Real[N], A_Imag[N];
#else
$input CIVL_RTYPE A_Real[N];
#endif

int main(void) {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);
  $vec x = $vec_zero(0);
  int normType;
  if (rank == 0) {
    STYPE value[N];
    for (int i = 0; i < N; i++) {
#ifdef USE_COMPLEX
      value[i] = $make_complex(A_Real[i], A_Imag[i]);
#else
      value[i] = A_Real[i];
#endif
    }
    x = $vec_make_from_dense(N, value);
    $print("CIVL:");
    $vec_print(x);
  }

  Vec p_x = civlToPetscVec(x, PETSC_DECIDE, comm);
  CIVL_RTYPE expected = 0.0, actual = 0.0;
  PetscErrorCode err_actual = VecNormalize(p_x, &actual);
  PetscErrorCode err_expected = VecNormalize_spec(p_x, &expected);
  $assert(err_actual == err_expected);
  $assert(actual == expected);
  if (rank == 0) {
    $print("N = ", N, "\n");
    $pathCondition();
    $print("actual   = ", actual, "\n", "Expected = ", expected, "\n");
  }
  VecDestroy(&p_x);
  MPI_Finalize();
}
