#include <mpi.h>
#include <petscvec.h>
#include <stdio.h>
#undef VecNormalize
PetscErrorCode VecNormalize(Vec x, PetscReal *val);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);

$input CIVL_RTYPE A_Real[N];
#ifdef USE_COMPLEX
$input CIVL_RTYPE A_Imag[N];
#else
#endif

int main(void) {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);
  $vec x = $vec_zero(N);
  if (rank == 0) {
    STYPE value[N];
    for (int i = 0; i < N; i++)
      value[i] = scalar_make(A_Real[i], A_Imag[i]);

    x = $vec_make_from_dense(N, value);
    $print("\nN = ", N, "\nx: ");
    $vec_print(x);
  }

  Vec p_x = civlToPetscVec(x, PETSC_DECIDE, comm);
  Vec p_expected = civlToPetscVec(x, PETSC_DECIDE, comm);

  CIVL_RTYPE expected = 0.0, actual = 0.0;
  PetscErrorCode err_actual = VecNormalize(p_x, &actual);
  VecNormalize_spec(p_expected, &expected);
  $assert(err_actual == 0);
    if (rank == 0) {
    $print("\n");
    $pathCondition();
    $print("\nActual   = ", actual, "\n", "Expected = ", expected, "\n");
  }
  $assert(actual == expected);

  VecDestroy(&p_x);
  VecDestroy(&p_expected);
  MPI_Finalize();
}
