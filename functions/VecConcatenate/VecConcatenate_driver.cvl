#include "petscvec.h"
#include <mpi.h>
#include <stdio.h>
#undef VecConcatenate

PetscErrorCode VecConcatenate(PetscInt nx, const Vec X[], Vec *Y, IS *x_is[]);

$input int N_MIN, N_MAX, NX;
$assume(N_MIN <= NX && NX <= N_MAX);

$input int B, X_SIZE;
$assume(1 <= X_SIZE && X_SIZE <= B);

$input CIVL_RTYPE X_Real[NX * X_SIZE];
#ifdef USE_COMPLEX
$input CIVL_RTYPE X_Imag[NX * X_SIZE];
#endif

int main() {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);

  /* Create NX CIVL vectors from one-dimensional input arrays.
  For vector i, the jth element is taken from index(i * X_SIZE + j).*/
  $vec X[NX];
  if (rank == 0) {
    for (int i = 0; i < NX; i++) {
      STYPE x_values[X_SIZE];
      for (int j = 0; j < X_SIZE; j++) {
        x_values[j] =
            scalar_make(X_Real[i * X_SIZE + j], X_Imag[i * X_SIZE + j]);
      }
      X[i] = $vec_make_from_dense(X_SIZE, x_values);
    }

    $print("\nNumber of vectors to be concatenated (NX) : ", NX, " & Array containing the vectors X[B] : ", X_SIZE, "\n");
    for (int i = 0; i < NX; i++) {
      $print("x[", i, "]: ");
      $vec_print(X[i]);
    }
  }

  // Convert the CIVL vectors to PETSc Vecs
  Vec petsc_X[NX], Y_actual, Y_expected;
  for (int i = 0; i < NX; i++)
    petsc_X[i] = civlToPetscVec(X[i], PETSC_DECIDE, comm);

  // Call the actual VecConcatenate
  PetscErrorCode err_actual = VecConcatenate(NX, petsc_X, &Y_actual, NULL);
  $assert(err_actual == 0, "VecConcatenate returned an error.");
  VecConcatenate_spec(NX, petsc_X, &Y_expected, NULL);

  if (rank == 0) {
    $print("\n");
    $pathCondition();
  }
  vecprint_mpi("Actual  ", Y_actual);
  vecprint_mpi("Expected", Y_expected);

  // Validate that the actual and expected concatenated vectors are equal
  PetscBool flg;
  VecEqual(Y_actual, Y_expected, &flg);
  $assert(flg, "VecConcatenate output mismatch.");

  // Cleanup
  VecDestroy(&Y_actual);
  VecDestroy(&Y_expected);
  for (int i = 0; i < NX; i++)
    VecDestroy(&petsc_X[i]);

  MPI_Finalize();
  return 0;
}
