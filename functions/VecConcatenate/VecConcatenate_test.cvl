#include "petscvec.h"
#include <mpi.h>
#include <stdio.h>

/*
  Unit test for VecConcatenate with static inputs NX =2 & X_SIZE = 2.

  We define two vectors:
    - Vector 0: [0, 1]
    - Vector 1: [2, 3]
  The expected concatenated vector is [0, 1, 2, 3].
*/

$input int NX = 2;
$input int X_SIZE = 2;

int main() {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);

  /* Create NX CIVL vectors with fixed values.
     For vector i, the jth element is taken from index (i*X_SIZE + j) of the input arrays. */
  $vec X_civl[NX];
  for (int i = 0; i < NX; i++) {
    STYPE vec_vals[X_SIZE];
    for (int j = 0; j < X_SIZE; j++)
      vec_vals[j] = scalar_make(i * X_SIZE + j, 0.0);
    X_civl[i] = $vec_make_from_dense(X_SIZE, vec_vals);
  }

  if (rank == 0) {
    $print("Input CIVL Vectors:\n");
    for (int i = 0; i < NX; i++) {
      $print("Vector ", i, ":\n");
      $vec_print(X_civl[i]);
    }
  }

  // Convert the CIVL vectors to PETSc Vecs
  Vec petsc_X[NX];
  for (int i = 0; i < NX; i++) {
    petsc_X[i] = civlToPetscVec(X_civl[i], PETSC_DECIDE, comm);
  }

  // Call VecConcatenate to produce the concatenated vector
  Vec Y_actual;
  PetscErrorCode err_actual = VecConcatenate(NX, petsc_X, &Y_actual, NULL);
  $assert(err_actual == 0, "VecConcatenate returned an error.");

  // Build the expected result as a CIVL vector, then convert it to a PETSc Vec.
  STYPE y_vals[NX * X_SIZE];
  for (int j = 0; j < (NX * X_SIZE); j++)
      y_vals[j] = scalar_make(j, 0.0);

  $vec Y_expected_civl = $vec_make_from_dense(NX * X_SIZE, y_vals);
  Vec Y_expected = civlToPetscVec(Y_expected_civl, PETSC_DECIDE, comm);

  // Optionally, print the concatenated vectors
  vecprint_mpi("Y_actual  ", Y_actual);
  vecprint_mpi("Y_expected", Y_expected);

  // Validate that the actual and expected concatenated vectors are equal
  PetscBool flg;
  VecEqual(Y_actual, Y_expected, &flg);
  $assert(flg, "VecConcatenate output mismatch.");

  // Cleanup
  VecDestroy(&Y_actual);
  VecDestroy(&Y_expected);
  for (int i = 0; i < NX; i++)
    VecDestroy(&petsc_X[i]);

  MPI_Finalize();
  return 0;
}
