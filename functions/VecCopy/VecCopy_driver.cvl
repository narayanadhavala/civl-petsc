#include "petscvec.h"
#include <mpi.h>
#include <stdio.h>
#undef VecCopy

PetscErrorCode VecCopy(Vec x, Vec y);

$input int N_MIN, N_MAX, N, NV;
$assume(N_MIN <= N && N <= N_MAX);

#ifdef USE_COMPLEX
$input CIVL_RTYPE X_Real[N], X_Imag[N];
#else
$input CIVL_RTYPE X_Real[N];
#endif

int main(void) {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);

  $vec x = $vec_zero(N);
  $vec y = $vec_zero(N);
  $vec expected = $vec_zero(N);

  STYPE x_values[N];

  if (rank == 0) {
    for (int i = 0; i < N; i++)
      x_values[i] = $cmake(X_Real[i], X_Imag[i]);

    x = $vec_make_from_dense(N, x_values);

    $print("Vector x:\n");
    $vec_print(x);
    $print("Vector y:\n");
    $vec_print(y);
    $print("Vector Expected:\n");
    $vec_print(expected);
  }

  Vec p_x = civlToPetscVec(x, PETSC_DECIDE, comm);
  Vec p_y = civlToPetscVec(x, PETSC_DECIDE, comm);
  Vec p_expected = civlToPetscVec(expected, PETSC_DECIDE, comm);

  PetscErrorCode err_actual = VecCopy(p_x, p_y);
  PetscErrorCode err_expected = VecCopy_spec(p_x, p_expected);

  $assert(err_actual == err_expected);
  bool flg;
  VecEqual(p_y, p_expected, &flg);
  $assert(flg, "VecCopy mismatch between actual and expected results.");

  if (rank == 0)
    $pathCondition();

  vecprint_mpi("Actual   Copy", p_y);
  vecprint_mpi("Expected Copy", p_expected);

  VecDestroy(&p_x);
  VecDestroy(&p_y);
  VecDestroy(&p_expected);

  MPI_Finalize();
}
