#include "petscvec.h"
#include <mpi.h>
#include <stdio.h>
#undef VecSet_Seq
PetscErrorCode VecSet_Seq(Vec x, PetscScalar alpha);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);

$input CIVL_RTYPE alpha_Real;
#ifdef USE_COMPLEX
$input CIVL_RTYPE alpha_Imag;
#endif

int main() {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);
  $vec x = $vec_zero(N), y = $vec_zero(N);

  STYPE alpha = scalar_make(alpha_Real, alpha_Imag);

  if (rank == 0) {
    $print("\nN = ", N, ", alpha = ", alpha, "\nx: ");
    $vec_print(x);
  }

  Vec actual = civlToPetscVec(x, PETSC_DECIDE, comm);
  Vec expected = civlToPetscVec(y, PETSC_DECIDE, comm);
  PetscErrorCode err_actual = VecSet_Seq(actual, alpha);
  VecSet_Seq_spec(expected, alpha);

  $assert(err_actual == 0);
  if (rank == 0) {
    $print("\n");
    $pathCondition();
  }
  vecprint_mpi("Actual  ", actual);
  vecprint_mpi("Expected", expected);
  bool flg;
  VecEqual(actual, expected, &flg);
  $assert(flg, "VecSet_Seq mismatch  for actual and expected values.");

  VecDestroy(&actual);
  VecDestroy(&expected);
  MPI_Finalize();
}
