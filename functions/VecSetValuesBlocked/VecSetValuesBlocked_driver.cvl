#include "petscvec.h"
#include <mpi.h>
#include <stdio.h>
#undef VecSetValuesBlocked

PetscErrorCode VecSetValuesBlocked(Vec x, PetscInt ni, const PetscInt ix[],
                                   const PetscScalar y[], InsertMode iora);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);
$input int bs;
$assume(bs > 0 && bs <= N);
$input int niBlocks;
$assume(0 <= niBlocks && niBlocks <= (N / bs));

$input int blockIx[niBlocks];
$assume($forall(int i : 0..niBlocks - 1)(0 <= blockIx[i] &&
                                         blockIx[i] < (N / bs)));
$assume($forall(int j : 0..niBlocks - 1) $forall(int k : 0..j - 1)
            blockIx[j] != blockIx[k]);

#ifdef USE_COMPLEX
$input CIVL_RTYPE Y_Real[bs * niBlocks], Y_Imag[bs * niBlocks], X_Real[N],
    X_Imag[N];
#else
$input CIVL_RTYPE Y_Real[bs * niBlocks], X_Real[N];
#endif

int main(void) {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);

  $vec civl_x = $vec_zero(N);
  STYPE x_vals[N];
  STYPE y_vals[bs * niBlocks];

  if (rank == 0) {
    for (int i = 0; i < N; i++) {
#ifdef USE_COMPLEX
      x_vals[i] = $make_complex(X_Real[i], X_Imag[i]);
#else
      x_vals[i] = X_Real[i];
#endif
    }

    for (int i = 0; i < bs * niBlocks; i++) {
#ifdef USE_COMPLEX
      y_vals[i] = $make_complex(Y_Real[i], Y_Imag[i]);
#else
      y_vals[i] = Y_Real[i];
#endif
    }

    civl_x = $vec_make_from_dense(N, x_vals);

    $print("Initial CIVL Vector x:\n");
    $vec_print(civl_x);

    $print("\nBlock insertion data (y):\n");
    for (int i = 0; i < bs * niBlocks; i++)
      $cprint(y_vals[i]);

    $print("Block indices (blockIx):\n");
    for (int i = 0; i < niBlocks; i++)
      $print("blockIx[", i, "] = ", blockIx[i], "\n");
  }

  Vec p_x = civlToPetscVec(civl_x, PETSC_DECIDE, comm);
  Vec expected_x = civlToPetscVec(civl_x, PETSC_DECIDE, comm);

  VecSetBlockSize(p_x, bs);
  VecSetBlockSize(expected_x, bs);

  PetscErrorCode err_actual =
      VecSetValuesBlocked(p_x, niBlocks, blockIx, y_vals, INSERT_VALUES);
  PetscErrorCode err_expected = VecSetValuesBlocked_spec(
      expected_x, niBlocks, blockIx, y_vals, INSERT_VALUES);

  $assert(err_actual == err_expected,
          "Error codes do not match in VecSetValuesBlocked.");

  PetscBool flg;
  VecEqual(p_x, expected_x, &flg);
  $assert(flg, "Vector mismatch after VecSetValuesBlocked.");

  if (rank == 0) {
    $print("\n");
    $pathCondition();
  }
  vecprint_mpi("\nActual   VecSetValuesBlocked", p_x);
  vecprint_mpi("\nExpected VecSetValuesBlocked", expected_x);
  $print("\n");

  VecDestroy(&p_x);
  VecDestroy(&expected_x);

  MPI_Finalize();
}
