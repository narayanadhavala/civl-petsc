#include "petscvec.h"
#include <mpi.h>
#include <stdio.h>
#undef VecSetValuesBlocked

PetscErrorCode VecSetValuesBlocked(Vec x, PetscInt ni, const PetscInt ix[],
                                   const PetscScalar y[], InsertMode iora);

$input int N_MIN, N_MAX, N;
$assume(N_MIN <= N && N <= N_MAX);
$input int bs;
$assume(bs > 0 && bs <= N);
$input int niBlocks;
$assume(0 <= niBlocks && niBlocks <= (N / bs));

$input int blockIx[niBlocks];
$assume($forall(int i : 0..niBlocks - 1)(0 <= blockIx[i] &&
                                         blockIx[i] < (N / bs)));
$assume($forall(int j : 0..niBlocks - 1) $forall(int k : 0..j - 1)
            blockIx[j] != blockIx[k]);

$input CIVL_RTYPE Y_Real[bs * niBlocks], X_Real[N];
#ifdef USE_COMPLEX
$input CIVL_RTYPE Y_Imag[bs * niBlocks], X_Imag[N];
#endif

int main(void) {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);

  $vec civl_x = $vec_zero(N);
  STYPE x_vals[N], y_vals[bs * niBlocks];

  if (rank == 0) {
    for (int i = 0; i < N; i++)
      x_vals[i] = scalar_make(X_Real[i], X_Imag[i]);

    for (int i = 0; i < bs * niBlocks; i++)
      y_vals[i] = scalar_make(Y_Real[i], Y_Imag[i]);

    civl_x = $vec_make_from_dense(N, x_vals);

    $print("\nN = ", N, ", ni = ", niBlocks, "\n");
    $print("Array of values y: [");
    for (int i = 0; i < bs * niBlocks; i++) {
      scalar_print(y_vals[i]);
      if (i < (bs * niBlocks - 1)) $print(", ");
    }
    $print("] at Block Indices (ix): [");
    for (int i = 0; i < niBlocks; i++) {
      $print(blockIx[i]);
      if (i < (niBlocks - 1)) $print(", ");
    }
    $print("]\nx: ");
    $vec_print(civl_x);
  }

  Vec p_x = civlToPetscVec(civl_x, PETSC_DECIDE, comm);
  Vec expected_x = civlToPetscVec(civl_x, PETSC_DECIDE, comm);

  VecSetBlockSize(p_x, bs);
  VecSetBlockSize(expected_x, bs);

  PetscErrorCode err_actual =
      VecSetValuesBlocked(p_x, niBlocks, blockIx, y_vals, INSERT_VALUES);
  VecSetValuesBlocked_spec(
      expected_x, niBlocks, blockIx, y_vals, INSERT_VALUES);

  $assert(err_actual == 0);
  if (rank == 0) {
    $print("\n");
    $pathCondition();
  }
  vecprint_mpi("Actual  ", p_x);
  vecprint_mpi("Expected", expected_x);
  PetscBool flg;
  VecEqual(p_x, expected_x, &flg);
  $assert(flg, "VecSetValuesBlocked mismatch between actual and expected values.");

  VecDestroy(&p_x);
  VecDestroy(&expected_x);

  MPI_Finalize();
}
