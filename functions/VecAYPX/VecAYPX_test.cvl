#include "petscvec.h"
#include <mpi.h>
#include <stdio.h>

$input int n = 5;
$input double scale = 5;

int main(void) {
  MPI_Init(NULL, NULL);
  MPI_Comm comm = MPI_COMM_WORLD;
  int rank;
  MPI_Comm_rank(comm, &rank);
  // Vectors x and y
  $vec x = $vec_zero(n);
  $vec y = $vec_zero(n);
  $vec z = $vec_zero(n);

  STYPE x_values[n], y_values[n], beta, expected[n];

#ifdef USE_COMPLEX
  beta = $make_complex(scale, 0.0);
#else
  beta = scale;
#endif

  if (rank == 0) {
    for (int i = 0; i < n; i++) {
#ifdef USE_COMPLEX
      x_values[i] = $make_complex((double)(i + 1), 0.0);
      y_values[i] = $make_complex((double)(i + 1), 0.0);
      expected[i] = $make_complex(0.0, 0.0);
#else
      x_values[i] = (double)(i + 1);
      y_values[i] = (double)(i + 1);
      expected[i] = 0.0;
#endif
    }

    // Calculate expected results based on the value of beta
    for (int i = 0; i < n; i++) {
#ifdef USE_COMPLEX
      if ($creal(beta) == 0.0 && $cimag(beta) == 0.0) {
        // beta == 0: y remains unchanged
        expected[i] = y_values[i];
      } else if ($creal(beta) == 1.0 && $cimag(beta) == 0.0) {
        // beta == 1: y = y + x
        expected[i] = $cadd(y_values[i], x_values[i]);
      } else if ($creal(beta) == -1.0 && $cimag(beta) == 0.0) {
        // beta == -1: y = y - x
        expected[i] = $csub(y_values[i], x_values[i]);
      } else {
        // y = beta * y + x
        STYPE scaled_y = $cmul(beta, y_values[i]);
        expected[i] = $cadd(scaled_y, x_values[i]);
      }
#else
      if (beta == 0.0) {
        // beta == 0: y remains unchanged
        expected[i] = y_values[i];
      } else if (beta == 1.0) {
        // beta == 1: y = y + x
        expected[i] += x_values[i];
      } else if (beta == -1.0) {
        // beta == -1: y = y - x
        expected[i] -= x_values[i];
      } else {
        // y = beta * y + x
        expected[i] = beta * y_values[i] + x_values[i];
      }
#endif
    }

    x = $vec_make_from_dense(n, x_values);
    y = $vec_make_from_dense(n, y_values);
    z = $vec_make_from_dense(n, expected);

    $print("CIVL:");
    $print("Vector x:\n");
    $vec_print(x);
    $print("Vector y:\n");
    $vec_print(y);
  }

  Vec p_x = civlToPetscVec(x, PETSC_DECIDE, comm);
  Vec p_y = civlToPetscVec(y, PETSC_DECIDE, comm);
  Vec expectedAYPX = civlToPetscVec(z, PETSC_DECIDE, comm);
  PetscErrorCode err_actual = VecAYPX(p_y, beta, p_x);
  $assert(err_actual == 0);
  bool flg;
  VecEqual(p_y, expectedAYPX, &flg);
  $assert(flg == $true, "VecAYPX mismatch.");
  if (rank == 0) {
    $print("\n");
    $pathCondition();
  }
  vecprint_mpi("Actual   AYPX", p_y);
  vecprint_mpi("Expected AYPX", expectedAYPX);

  VecDestroy(&p_x);
  VecDestroy(&p_y);
  VecDestroy(&expectedAYPX);

  MPI_Finalize();
  return 0;
}
